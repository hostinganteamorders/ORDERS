# =============================================
# ORDERS Admin Panel - Environment Variables
# =============================================

# --- AI ChatBot (MegaLLM) ---
# Copy from your original setup
OPENAI_API_KEY=your_megallm_api_key_here
OPENAI_BASE_URL=https://ai.megallm.io/v1
OPENAI_MODEL=deepseek-ai/deepseek-v3.1

# --- Supabase (wajib untuk admin panel) ---
# Ambil dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key

# --- Google Calendar (untuk sinkronisasi jadwal) ---
# Ambil dari: Google Cloud Console -> Credentials (OAuth Client Web)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Redirect URI harus match dengan yang didaftarkan di Google Cloud Console
GOOGLE_REDIRECT_URI=https://ordersapp.tech/api/google/callback

# --- Google Calendar tanpa OAuth (opsional, langsung jalan) ---
# Kalender live (embed iframe): Google Calendar -> Settings -> Integrate calendar -> Embed code (ambil src=...)
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/embed?src=your-calendar-id%40group.calendar.google.com&ctz=Asia%2FMakassar
# Impor event (ICS): Settings -> Integrate calendar -> Secret address in iCal format (data lengkap) / Public address
GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/your-calendar-id%40group.calendar.google.com/private-xxx/basic.ics
# Email kalender (opsional) - untuk tombol "+ Tambahkan ke Google Calendar" yang mengundang kalender ini
NEXT_PUBLIC_GOOGLE_CALENDAR_EMAIL=your-calendar-id@group.calendar.google.com